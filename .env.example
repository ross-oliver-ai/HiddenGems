# Railway Postgres: use the PUBLIC connection URL (Vercel can't reach the private .railway.internal one)
DATABASE_URL=postgres://user:password@host:port/railway
# Random string, 32+ characters. Generate one with: openssl rand -base64 48
AUTH_SECRET=
# Item photos: connecting a Vercel Blob store to the project adds either BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID automatically
BLOB_READ_WRITE_TOKEN=
# One-time secret (12+ chars) to protect the /setup page; delete it after setup
SETUP_TOKEN=

# Railway Postgres: use the PUBLIC connection URL (Vercel can't reach the private .railway.internal one)
DATABASE_URL=postgres://user:password@host:port/railway
# Random string, 32+ characters. Generate one with: openssl rand -base64 48
AUTH_SECRET=
# Item photos: connecting a Vercel Blob store to the project adds either BLOB_READ_WRITE_TOKEN or BLOB_STORE_ID automatically
BLOB_READ_WRITE_TOKEN=
# One-time secret (12+ chars) to protect the /setup page; delete it after setup
SETUP_TOKEN=
# Billing (all optional; nothing is charged or locked until BILLING_ENABLED=true AND the two Stripe keys are set)
BILLING_ENABLED=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: the Stripe Price to charge. If empty, £3/month is created inline.
STRIPE_PRICE_ID=
# Protects the daily trial-reminder job (any long random string)
CRON_SECRET=
# Optional: trial length in days (default 30) and price in pence (default 300)
TRIAL_DAYS=
PRICE_PENCE=
# Optional: AI photo fill (Anthropic API key). Without it the feature stays off even when switched on in the admin
ANTHROPIC_API_KEY=
